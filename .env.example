# ===========================================================================
# Local LLM Document Q&A Chatbot (RAG) - environment template
#
# Copy to `.env` and fill in the two mandatory values below.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# MANDATORY - leave blank here, you fill these in your own .env
# ---------------------------------------------------------------------------
# Base URL of the LLM server.
#   Ollama (default):                http://localhost:11434
#   OpenAI-compatible server:        http://localhost:8000/v1
OLLAMA_BASE_URL=

# Model tag (Ollama) or model id (OpenAI-compatible), e.g. qwen3:8b
OLLAMA_MODEL=

# Which wire protocol the URL speaks. Leave as `auto` to infer it from the
# URL: a path ending in /v1 means an OpenAI-compatible server, anything else
# means Ollama's native API. Set it explicitly only if auto-detection is wrong.
LLM_API_FLAVOR=auto

# Bearer token for the OpenAI-compatible flavor. Usually blank for a local
# server; required for a hosted endpoint that checks credentials.
LLM_API_KEY=

# ---------------------------------------------------------------------------
# LLM runtime tuning (optional)
# ---------------------------------------------------------------------------
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
# OLLAMA_NUM_CTX applies to the Ollama flavor only - OpenAI-compatible servers
# manage the context window server-side.
OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------------------
# Embedding + reranking models (small, CPU-friendly sentence-transformers)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FUSED=20
TOP_K_FINAL=5
RRF_K=60
RERANK_ENABLED=true

# ---------------------------------------------------------------------------
# Vector store (ChromaDB, HNSW index)
# ---------------------------------------------------------------------------
CHROMA_DIR=./data/vectorstore
CHROMA_COLLECTION=rag_documents
HNSW_M=32
HNSW_CONSTRUCTION_EF=200
HNSW_SEARCH_EF=100

# ---------------------------------------------------------------------------
# Semantic cache
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INGEST=10/minute
RATE_LIMIT_DEFAULT=120/minute

# ---------------------------------------------------------------------------
# Observability (RAGObserve)
# ---------------------------------------------------------------------------
RAGOBSERVE_ENABLED=true
RAGOBSERVE_PROJECT=local-llm-rag
RAGOBSERVE_DB_PATH=./.ragobserve/ragobserve.db

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
DEV_FAKE_LLM=false
MAX_UPLOAD_MB=25

# Allow POST /api/ingest/path to read any path the service account can reach.
# Leave false: by default ingestion paths are confined to ./data/documents.
ALLOW_INGEST_ANY_PATH=false

CORS_ORIGINS=*
